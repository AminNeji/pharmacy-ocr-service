# Copy to `.env` and adjust. Every value below is optional — the defaults in
# src/pharmacy_ocr/settings.py are production-safe except API_KEYS, which you
# must set before exposing the service outside localhost.

# --- Application ------------------------------------------------------------
ENVIRONMENT=production          # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json for aggregators, text for humans
DATA_DIR=./data                 # invoices/, outputs/, logs/, cache/ live here

# --- API security -----------------------------------------------------------
# Comma-separated. Empty means authentication is DISABLED (development only —
# the service refuses to start with ENVIRONMENT=production and no keys).
API_KEYS=
CORS_ORIGINS=                   # comma-separated origins; empty blocks browsers
DOCS_ENABLED=false              # /docs and /redoc; keep false in production
MAX_UPLOAD_BYTES=20971520       # 20 MiB, per file
MAX_BATCH_FILES=50              # files per folder upload to /v1/batches
MAX_BATCH_UPLOAD_BYTES=209715200  # 200 MiB, whole folder upload
RATE_LIMIT_PER_MINUTE=60        # per API key (or per client IP when unauthenticated)
MAX_CONCURRENT_EXTRACTIONS=2    # hard cap on in-flight OCR work
REQUEST_TIMEOUT_S=300

# --- Extraction -------------------------------------------------------------
EXTRACTION_MODE=hybrid          # hybrid | deterministic | llm
PHOTO_MODE=false                # true for phone photos, false for clean scans

# --- OCR --------------------------------------------------------------------
OCR_ENGINE=paddleocr            # paddleocr | vl
OCR_DEVICE=cpu                  # cpu | gpu
OCR_LANG=fr
OCR_VERSION=PP-OCRv5
OCR_MIN_CONFIDENCE=0.35
WARMUP_ON_STARTUP=true          # load models at boot so the first request is fast

# --- OCR cache --------------------------------------------------------------
USE_OCR_CACHE=true
FORCE_OCR_REFRESH=false
OCR_CACHE_MAX_ENTRIES=5000
OCR_CACHE_TTL_DAYS=30

# --- PDF rendering ----------------------------------------------------------
PDF_RENDER_DPI=220
PDF_MAX_PAGES=5

# --- LLM fallback (Ollama) --------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180

# --- Async job API ----------------------------------------------------------
JOB_RETENTION_MINUTES=60
JOB_QUEUE_MAX_SIZE=100
